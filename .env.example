# URL del proyecto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (pública) de Supabase. Respeta RLS. Segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de service role. BYPASEA RLS. Solo servidor, nunca exponer al cliente
# ni prefijarla con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada en redirects de auth, links de email, etc.).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token personal de Hugging Face (Settings > Access Tokens). Debe tener el
# permiso "Make calls to Inference Providers" habilitado (un token "Read"
# simple puede no alcanzar). Empieza con hf_. Solo servidor — nunca en el
# navegador, en un commit ni en el chat con el asistente.
HUGGINGFACEHUB_API_TOKEN=

# Opcionales: sobreescriben los defaults de lib/constants/ai.ts si el modelo
# gratuito rota (ver la Guía Hugging Face de MercadoTech_sesion4.md).
HUGGINGFACE_EMBEDDING_MODEL=
HUGGINGFACE_CHAT_MODEL=
